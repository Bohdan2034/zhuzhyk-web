{
  "uid": "obs-demo-red",
  "title": "Observability Demo - RED",
  "tags": ["demo", "observability"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "Request rate",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "req/s" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[1m])) by (route)",
          "legendFormat": "{{route}}"
        }
      ],
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Error rate (5xx)",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "targets": [
        {
          "expr": "100 * sum(rate(http_requests_error_total[1m])) / sum(rate(http_requests_total[1m]))",
          "legendFormat": "5xx %"
        }
      ],
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Latency p95",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_ms_bucket[5m])) by (le, route))",
          "legendFormat": "{{route}}"
        }
      ],
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 9 }
    },
    {
      "type": "timeseries",
      "title": "In-flight requests",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(http_inflight_requests)",
          "legendFormat": "inflight"
        }
      ],
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 9 }
    },
    {
      "type": "logs",
      "title": "Logs (Loki)",
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        {
          "expr": "{service=\"demo-app\"}",
          "maxLines": 10
        }
      ],
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 18 }
    },
    {
      "type": "table",
      "title": "Search traces",
      "pluginVersion": "10.4.5",
      "datasource": { "type": "tempo", "uid": "Tempo" },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.name = \"demo-app\" }",
          "limit": 10,
          "tableType": "traces",
          "filters": [
            {
              "id": "service-filter",
              "scope": "resource",
              "tag": "service.name",
              "operator": "=",
              "value": "demo-app",
              "valueType": "string"
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          },
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "startTime" },
            "properties": [{ "id": "unit", "value": "dateTimeAsIso" }]
          },
          {
            "matcher": { "id": "byName", "options": "duration" },
            "properties": [
              { "id": "unit", "value": "ms" },
              { "id": "decimals", "value": 0 }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "startTime" }],
        "footer": { "show": false, "enablePagination": false }
      },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 18 },
      "timeFrom": "1h"
    }
  ],
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m"],
    "time_options": ["5m", "15m", "30m", "1h", "6h", "12h", "24h"]
  },
  "templating": { "list": [] }
}
